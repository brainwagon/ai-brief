[Unit]
Description=Generate and Publish today's Edition of the AI brief
Documentation=https://github.com/brainwagon/ai-brief/issues/9
Documentation=file:///home/markv/ai-brief/CONTEXT.md
# A brief that stops publishing looks exactly like a quiet news day - the
# absence of an Edition is not something anyone notices from the Index. This
# makes a failed Run say so at once, and say which half of it broke.
OnFailure=ai-brief-failed.service

[Service]
Type=oneshot

# publish.sh is the whole contract: no arguments, no working directory, no
# environment. It finds the repo from its own path and the interpreter from
# the venv inside it, precisely so this line can stay one word long and so a
# systemd environment that has almost nothing in it is enough.
ExecStart=/home/markv/ai-brief/publish.sh

# The OpenRouter key Enrichment needs. A systemd unit sources no shell profile,
# so this is where the key comes from; publish.sh reads the same file when it
# is run by hand from somewhere the key is not exported. The leading - means a
# missing file is not a failure: the Run then publishes an all-Unenriched
# Edition, which is a describable day rather than a broken one.
EnvironmentFile=-/home/markv/.config/ai-brief/env

# The machine is a laptop somebody is using, and nothing waits on the brief, so
# it can have what is left over. It costs almost nothing either way: the whole
# Run is spent waiting on the network, Enrichment included, which is a hosted
# model rather than a local one.
Nice=10

# Not infinity, unlike the backup. A Run has a known way of hanging rather than
# failing: every Source and every Enrichment is a network call, and a free
# model behind a busy provider can stall well past its own timeout across
# retries. A wall lets the failure be reported instead of leaving the unit
# activating forever with no notification. A real Run of ~200 Items takes about
# five minutes at eight requests in flight, so 30 minutes is a wide margin.
TimeoutStartSec=30min
